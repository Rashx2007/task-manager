+// Stateful SQL double only. Does NOT prove real SQL Server locks/rollback or execute SQL.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import vm from 'node:vm';
+import fs from 'node:fs/promises';
+const source=await fs.readFile(new URL('../lib/task-status-service.js',import.meta.url),'utf8');
+const expected=code=>e=>e.code===code;
+function fixture(){return{task:{TaskID:202,Complited:0,Priorities:'زمان انجام ثابت',FixedDueTime:1,Durationtime:'02:00:00',DueDateTime:'2026-10-31 09:00:00',EndDateTime:'2026-10-31 11:00:00',Due_Date:'2026-10-31',Due_Time:'09:00:00',End_Date:'2026-10-31',End_Time:'11:00:00'},times:[{TaskID:202,TimeDateID:20,Priorities:'زمان انجام ثابت',FixedDueTime:1,Durationtime:'02:00:00',DueDateTime:'2026-10-31 09:00:00',EndDateTime:'2026-10-31 11:00:00',Due_Date:'2026-10-31',Due_Time:'09:00:00',End_Date:'2026-10-31',End_Time:'11:00:00',Finish_DateTime:null}],history:[],assets:[],ready:true,groupObject:false,groupMember:false};}
+async function setup(initial=fixture(),options={}){
+ let data=structuredClone(initial),commits=0,rollbacks=0,serial=0;const calls=[],writes=[];
+ const execute=async(sql,params=[],kind='tx')=>{calls.push({sql,params,kind});const tag=sql.match(/\/\* status:([\w-]+) \*\//)?.[1];if(/^\s*(?:\/\*.*?\*\/\s*)?(UPDATE|INSERT)/.test(sql)){writes.push({sql,params});if(options.failWrite===writes.length)throw Error('private SQL failure');}
+  if(tag==='ready')return[{Ready:data.ready?1:0}];if(tag==='task')return data.task?[structuredClone(data.task)]:[];if(tag==='times')return structuredClone(data.times);
+  if(tag==='group-object')return[{ObjectID:data.groupObject?100:null}];if(tag==='group-member')return data.groupMember?[{GroupID:1}]:[];
+  if(tag==='set'){data.task.Complited=params[0];return[];}if(tag==='finish'){for(const row of data.times)row.Finish_DateTime=params[0];return[];}
+  if(tag==='edit'){Object.assign(data.task,{TaskTtl:params[0],Descriptions:params[1],Priorities:params[2],tskType:params[3],IsConsiderableAction:params[4],Complited:params[5],FixedDueTime:params[6]});return[];}
+  if(sql.startsWith('SELECT AssetTaskID'))return data.assets;
+  if(sql.startsWith('UPDATE Asset_Task_tbl')){data.assets=[{TaskID:params[1],AssetID:params[0]}];return[];}
+  if(sql.startsWith('INSERT INTO Asset_Task_tbl')){data.assets.push({TaskID:params[0],AssetID:params[1]});return[];}
+  if(tag==='append'){if(options.noHistoryId)return[];const row={HistoryID:String(data.history.length+1),OperationID:params[0],TaskID:params[1],Action:params[2],BeforeStatus:params[3],AfterStatus:params[4],BeforeState:params[5],AfterState:params[6],OccurredAtWall:params[7],Source:params[8],AppActor:params[9]};data.history.push(row);return[{HistoryID:row.HistoryID}];}
+  if(tag==='history'){const[cursor,size,id]=params;return data.history.filter(row=>row.TaskID===id&&(cursor==null||BigInt(row.HistoryID)<BigInt(cursor))).sort((a,b)=>BigInt(a.HistoryID)>BigInt(b.HistoryID)?-1:1).slice(0,size);}
+  throw Error('Unhandled SQL '+sql);
+ };
+ const context=vm.createContext({Date,console});const m=new vm.SourceTextModule(source,{context});
+ await m.link(name=>{const ex=name==='server-only'?{}:name==='node:crypto'?{randomUUID:()=>`00000000-0000-4000-8000-${String(++serial).padStart(12,'0')}`} :name==='./assetRules'?{normalizeDigits:v=>String(v??'').replace(/[۰-۹]/g,c=>'۰۱۲۳۴۵۶۷۸۹'.indexOf(c))}:name==='./schedule-logic'?{formatSqlDateTime:()=> '2026-10-30 10:20:30',nowWall:()=>new Date('2026-10-30T10:20:30Z')}:name==='./task-groups'?{lockTaskSchedule:async()=>{if(options.busy){const e=Error('busy');e.code='GROUP_BUSY';throw e;}}}:{query:(sql,params)=>execute(sql,params,'query'),runTransaction:async fn=>{const before=structuredClone(data);try{const value=await fn((s,p)=>execute(s,p));commits++;return value;}catch(e){data=before;rollbacks++;throw e;}}};return new vm.SyntheticModule(Object.keys(ex),function(){for(const[k,v]of Object.entries(ex))this.setExport(k,v);},{context});});await m.evaluate();return{api:m.namespace,data:()=>data,calls,writes,stats:()=>({commits,rollbacks})};
+}
+const edit=(extra={})=>({TaskTtl:'updated',Descriptions:'not in snapshot',Priorities:'زمان انجام ثابت',FixedDueTime:1,Complited:0,statusIntent:'preserve',...extra});
+const plan=row=>Object.fromEntries(Object.entries(row).filter(([key])=>/^(Due|End)/.test(key)));
+test('Complete preserves every planned date/time and records before/after in the same transaction',async()=>{const f=fixture(),h=await setup(f),r=await h.api.completeTask('۲۰۲');assert.equal(r.historyId,'1');assert.equal(h.data().task.Complited,1);assert.deepEqual(plan(h.data().times[0]),plan(f.times[0]));assert.deepEqual(plan(h.data().task),plan(f.task));assert.equal(h.data().times[0].Finish_DateTime,'2026-10-30 10:20:30');const log=h.data().history[0];assert.equal(log.Action,'COMPLETE');assert.equal(JSON.parse(log.BeforeState).task.Complited,0);assert.equal(JSON.parse(log.AfterState).task.Complited,1);assert.equal(log.AppActor,null);assert.equal(h.stats().commits,1);assert.ok(h.calls.every(c=>c.kind==='tx'));});
+test('Repeat complete is idempotent and does not reset finish time or duplicate audit',async()=>{const h=await setup();await h.api.completeTask(202);const finish=h.data().times[0].Finish_DateTime;assert.equal((await h.api.completeTask(202)).alreadyCompleted,true);assert.equal(h.data().history.length,1);assert.equal(h.data().times[0].Finish_DateTime,finish);});
+test('Explicit reopen preserves fixed plan, clears actual finish and archives prior finish',async()=>{const f=fixture();f.task.Complited=1;f.times[0].Finish_DateTime='2026-10-29 08:00:00';const h=await setup(f);await h.api.saveTaskEdit(202,edit({statusIntent:'change',expectedStatus:1}));assert.equal(h.data().task.Complited,0);assert.equal(h.data().times[0].Finish_DateTime,null);assert.deepEqual(plan(h.data().times[0]),plan(f.times[0]));const log=h.data().history[0];assert.equal(log.Action,'REOPEN');assert.equal(JSON.parse(log.BeforeState).timeDates[0].Finish_DateTime,'2026-10-29 08:00:00');});
+test('Explicit completion through task PUT shares the same audit and finish behavior',async()=>{const h=await setup();const r=await h.api.saveTaskEdit(202,edit({Complited:1,statusIntent:'change',expectedStatus:0}));assert.equal(r.Complited,1);assert.equal(h.data().history[0].Source,'/api/tasks/[id]');assert.equal(h.data().times[0].EndDateTime,'2026-10-31 11:00:00');});
+test('Normal edit preserves current completed status despite stale form value zero',async()=>{const f=fixture();f.task.Complited=1;const h=await setup(f);const r=await h.api.saveTaskEdit(202,edit());assert.equal(r.Complited,1);assert.equal(r.statusChanged,false);assert.equal(h.data().history.length,0);assert.equal(h.data().times[0].Finish_DateTime,null);});
