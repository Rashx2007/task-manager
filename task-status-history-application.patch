+test('Old clients cannot silently reopen a completed task',async()=>{const f=fixture();f.task.Complited=1;const h=await setup(f);const body=edit();delete body.statusIntent;await assert.rejects(h.api.saveTaskEdit(202,body),expected('STATUS_INTENT_REQUIRED'));assert.equal(h.writes.length,0);});
+test('Explicit change requires expected status; invalid status/intent is rejected',async()=>{const h=await setup();await assert.rejects(h.api.saveTaskEdit(202,edit({Complited:1,statusIntent:'change'})),expected('STATUS_VERSION_REQUIRED'));for(const body of [edit({Complited:2}),edit({statusIntent:'bad'}),null])await assert.rejects(h.api.saveTaskEdit(202,body));assert.equal(h.writes.length,0);});
+test('Missing history blocks complete/reopen before writing but allows status-preserving edits',async()=>{for(const completed of [0,1]){const f=fixture();f.ready=false;f.task.Complited=completed;const h=await setup(f);await assert.rejects(completed?h.api.saveTaskEdit(202,edit({statusIntent:'change',expectedStatus:1})):h.api.completeTask(202),expected('STATUS_HISTORY_NOT_READY'));assert.equal(h.writes.length,0);}const f=fixture();f.ready=false;const h=await setup(f);assert.equal((await h.api.saveTaskEdit(202,edit())).statusChanged,false);});
+test('Audit INSERT failure rolls back task, actual finish and asset edit in SQL double',async()=>{const f=fixture(),h=await setup(f,{failWrite:5});await assert.rejects(h.api.saveTaskEdit(202,edit({Complited:1,statusIntent:'change',expectedStatus:0,AssetID:99})));assert.deepEqual(h.data(),f);assert.equal(h.stats().rollbacks,1);});
+test('Missing inserted history ID rolls back completion in SQL double',async()=>{const f=fixture(),h=await setup(f,{noHistoryId:true});await assert.rejects(h.api.completeTask(202),expected('HISTORY_INSERT_FAILED'));assert.deepEqual(h.data(),f);});
+test('No time row is fabricated; multiple existing rows are captured and retain their plans',async()=>{const f=fixture();f.times=[];const h=await setup(f);await h.api.completeTask(202);assert.equal(h.data().times.length,0);assert.deepEqual(JSON.parse(h.data().history[0].BeforeState).timeDates,[]);const g=fixture();g.times.push({...g.times[0],TimeDateID:21});const j=await setup(g);await j.api.completeTask(202);assert.equal(JSON.parse(j.data().history[0].AfterState).timeDates.length,2);assert.equal(j.data().times[1].EndDateTime,g.times[1].EndDateTime);});
