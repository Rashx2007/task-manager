+const source=await fs.readFile(new URL('../components/TaskForm.jsx',import.meta.url),'utf8');const a=source.indexOf('  const handleSubmit = async'),b=source.indexOf('\n  const inp',a),handler=source.slice(a,b);
+async function submit({loaded=1,chosen=1,serverStatus=chosen,done=false,error=false,completionError=false}={}){
+ const calls=[],notices=[],state={saved:0,asks:0,showTimes:0,showPeople:0,saving:null,form:{TaskTtl:'sample',Descriptions:'draft',Priorities:'زمان انجام ثابت',FixedDueTime:true,Complited:chosen,AssetID:'',RequestNumber:'',RegisterNumber:'',RequestDate:''}};
+ const ref={current:loaded};const context=vm.createContext({form:state.form,currentTaskId:202,loadedStatusRef:ref,showToast:(...v)=>notices.push(v),alert:v=>notices.push([v]),setSaving:v=>state.saving=v,setForm:fn=>state.form=fn(state.form),setCurrentTaskId:()=>{},markSaved:()=>state.saved++,onSaved:()=>{},askComplete:async()=>{state.asks++;return done;},applicantClickedRef:{current:true},timeDateClickedRef:{current:true},autoTimeDateRef:{current:false},pendingCloseAskRef:{current:false},setShowTimeDate:()=>state.showTimes++,setShowAFModal:()=>state.showPeople++,confirm:()=>false,onClose:()=>{},fetch:async(url,options)=>{calls.push({url,options});if(error)throw Error('network');const completion=url==='/api/complete';return{ok:!(completion&&completionError),json:async()=>completion?{success:!completionError,error:completionError?'safe failure':undefined}:{success:true,Complited:serverStatus,statusChanged:loaded!==serverStatus}};}});
+ vm.runInContext(handler+'\nthis.submit=handleSubmit;',context);await context.submit({preventDefault(){}});return{calls,notices,state,ref};
+}
+test('Saving a completed task preserves status without implicit reopening or completion wizard',async()=>{const h=await submit();const body=JSON.parse(h.calls[0].options.body);assert.equal(body.Complited,1);assert.equal(body.statusIntent,'preserve');assert.equal(body.expectedStatus,1);assert.equal(h.calls.length,1);assert.equal(h.state.asks,0);assert.equal(h.state.saving,false);});
+test('Explicit reopening sends expected prior status and does not immediately ask to complete again',async()=>{const h=await submit({loaded:1,chosen:0,serverStatus:0});const body=JSON.parse(h.calls[0].options.body);assert.equal(body.statusIntent,'change');assert.equal(body.expectedStatus,1);assert.equal(body.Complited,0);assert.equal(h.state.asks,0);assert.equal(h.state.showTimes,0);assert.equal(h.ref.current,0);});
+test('Explicit completion choice uses one audited PUT with change intent',async()=>{const h=await submit({loaded:0,chosen:1,serverStatus:1});assert.equal(h.calls.length,1);assert.equal(JSON.parse(h.calls[0].options.body).statusIntent,'change');assert.equal(h.state.asks,0);});
+test('Stale unchanged form respects current server status and skips inappropriate completion prompt',async()=>{const h=await submit({loaded:0,chosen:0,serverStatus:1});assert.equal(JSON.parse(h.calls[0].options.body).statusIntent,'preserve');assert.equal(h.state.form.Complited,1);assert.equal(h.state.asks,0);});
+test('Traditional completion prompt uses complete API, never a second full PUT',async()=>{const h=await submit({loaded:0,chosen:0,serverStatus:0,done:true});assert.equal(h.calls.length,2);assert.equal(h.calls[1].url,'/api/complete');assert.deepEqual(JSON.parse(h.calls[1].options.body),{taskId:202});assert.equal(h.ref.current,1);assert.equal(h.state.form.Complited,1);});
+test('Failed completion is not reported as completed; form edits and status outcome are distinguished',async()=>{const h=await submit({loaded:0,chosen:0,serverStatus:0,done:true,completionError:true});assert.equal(h.ref.current,0);assert.ok(h.notices.some(n=>n[1]==='error'));assert.ok(!h.notices.some(n=>String(n[0]).includes('اتمام کار ثبت شد')));assert.equal(h.state.saving,false);});
+test('Network error releases save guard and produces no successful save marker',async()=>{const h=await submit({error:true});assert.equal(h.state.saving,false);assert.equal(h.state.saved,0);assert.ok(h.notices.some(n=>n[1]==='error'));});
+test('No forced zero/one PUT remains; loaded status comes from current server data',()=>{assert.ok(!source.includes('...payload, Complited: 0'));assert.ok(!source.includes('...payload, Complited: 1'));assert.ok(source.includes('loadedStatusRef.current = Number(src.Complited)'));assert.ok(handler.includes('finally'));});
