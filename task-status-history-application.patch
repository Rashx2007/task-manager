+test('Task PUT delegates the exact task ID and body to audited service',async()=>{const h=await route('../app/api/tasks/[id]/route.js'),body={Complited:0,statusIntent:'change',expectedStatus:1};const r=await h.api.PUT({json:async()=>body},{params:Promise.resolve({id:'202'})});assert.equal(r.body.historyId,'2');assert.equal(h.calls[0].id,'202');assert.equal(h.calls[0].body,body);});
+test('Task PUT rejects malformed JSON and propagates safe service errors',async()=>{const h=await route('../app/api/tasks/[id]/route.js');assert.equal((await h.api.PUT({json:async()=>{throw Error('bad');}},{params:{id:'202'}})).status,400);assert.equal(h.calls.length,0);const bad=await route('../app/api/tasks/[id]/route.js',true);assert.equal((await bad.api.PUT({json:async()=>({})},{params:{id:'202'}})).status,409);});
+test('History GET passes pagination and is no-store/read-only',async()=>{const h=await route('../app/api/task-status-history/route.js');const r=await h.api.GET({url:'http://test/?taskId=202&beforeId=9007199254740994&limit=50'});assert.equal(r.headers['Cache-Control'],'no-store');assert.equal(h.calls[0].beforeId,'9007199254740994');assert.equal(h.calls[0].limit,'50');assert.deepEqual(Object.keys(h.api),['GET']);});
+test('History GET returns safe service errors with no-store',async()=>{const h=await route('../app/api/task-status-history/route.js',true);const r=await h.api.GET({url:'http://test/?taskId=202'});assert.equal(r.status,409);assert.equal(r.body.code,'STATUS_CHANGED');assert.equal(r.headers['Cache-Control'],'no-store');});
