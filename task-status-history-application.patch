+test('History read supports bigint-safe cursor and pagination, including deleted-task history',async()=>{const f=fixture();f.task=null;f.history=[{HistoryID:'9007199254740994',TaskID:202},{HistoryID:'9007199254740993',TaskID:202}];const h=await setup(f);const first=await h.api.readTaskStatusHistory({taskId:202,limit:1});assert.equal(first.rows[0].HistoryID,'9007199254740994');const next=await h.api.readTaskStatusHistory({taskId:202,limit:1,beforeId:first.nextBeforeId});assert.equal(next.rows[0].HistoryID,'9007199254740993');assert.ok(h.calls.every(c=>c.kind==='query'));assert.equal(h.writes.length,0);});
